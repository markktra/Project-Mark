library(readxl)
companies <- read_excel("C:/Users/User/Downloads/companies.xlsx")
View(companies)

company <- companies[[1]]  
sales   <- companies[[2]]  
profits <- companies[[3]]  
assets  <- companies[[4]]  

radius <- sqrt(assets / pi)

symbols(x = sales, y = profits, circles = radius,
        inches = 0.45,
        fg = "black", bg = "lightgreen",
        xlim = c(30, 320), ylim = c(5, 29),
        main = "Bubble Plot of 10 Giant Companies (Bubble Size = Assets)",
        xlab = "Sales (Million USD)",
        ylab = "Profits (Million USD)")

text(sales, profits, labels = company, cex = 0.7, pos = 3)
