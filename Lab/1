J <- matrix(c( 1, 1, -2,
               -1, 2,  1,
               0, 1, -1), nrow = 3, ncol = 3, byrow = TRUE)

eig <- eigen(J)
eig$values
eig$vectors

tr_J <- sum(diag(J))
tr_J

det_J <- det(J)
det_J

sum(diag(J))
sum(eig$values)
all.equal(sum(diag(J)), sum(eig$values))
  
det(J)
prod(eig$values)
all.equal(det(J), prod(eig$values))

